# ====================================================================
# Injective CopyTrade (MVP) 配置文件
# ====================================================================

# 网络环境: mainnet (主网，默认推荐) 或 testnet (测试网)
NETWORK=mainnet

# 跟单机器人操作钱包私钥 (十六进制私钥，不要带 0x 或带 0x 均可；未配置时自动支持 $10,000 体验金演练)
FOLLOWER_PRIVATE_KEY=your_private_key_here

# 跟单机器人子账户序号 (默认 0 即主子账户，subaccount_index 0)
FOLLOWER_SUBACCOUNT_INDEX=0

# 要监听的聪明钱目标钱包地址 (Injective bech32 格式，以 inj 开头)
TARGET_TRADER_ADDRESS=inj1hkhdaj2a2pmvzjq5q4t0dn7mm9azgahfhdua9j

# 目标聪明钱子账户序号 (默认 0)
TARGET_SUBACCOUNT_INDEX=0

# ----------------- 跟单仓位策略 -----------------
# 跟单模式: FIXED_AMOUNT (固定保证金/名义本金) 或 RATIO (按目标交易比例)
COPY_MODE=FIXED_AMOUNT

# 若为 FIXED_AMOUNT: 单笔跟单固定名义金额 (单位: USDT)
FIXED_USDT_AMOUNT=50

# 若为 RATIO: 跟单比例 (例如 0.1 表示聪明钱下 1000 刀，跟单 100 刀)
COPY_RATIO=0.1

# ----------------- 风控参数 -----------------
# 允许的最大滑点百分比 (默认 1.5 即 1.5%)
MAX_SLIPPAGE_PERCENT=1.5

# 单笔跟单最大名义金额上限保护 (单位: USDT，防止大户异常大单爆仓跟单者)
MAX_NOTIONAL_PER_ORDER=200

# 默认衍生品杠杆倍数上限 (例如 5 表示最高 5x 杠杆)
MAX_LEVERAGE=5

# 是否开启仅模拟执行模式 (true: 仅打印跟单计算结果不上链; false: 真实签名上链)
DRY_RUN=false

# ----------------- Telegram 交易与获客机器人 (Phase 2) -----------------
# 从 Telegram 官方 @BotFather 免费申请的 Bot API Token (形如: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# 聪明钱信号免费广播频道/群组 ID (选填，例如: @YourAlphaChannel 或 -100123456789)
TELEGRAM_BROADCAST_CHAT_ID=

# 邀请好友返佣百分比 (默认 25 表示好友产生的手续费 25% 归邀请人)
REFERRAL_REWARD_PERCENT=25
